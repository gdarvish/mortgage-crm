# Firebase web SDK config — copy from Firebase Console -> Project settings -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to use the Firebase emulator suite during development.
VITE_USE_FIREBASE_EMULATOR=false

# reCAPTCHA v3 site key (optional) — enables bot protection on the public
# questionnaire and signature forms. Leave empty to disable reCAPTCHA.
# Create keys at https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=
