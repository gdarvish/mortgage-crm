rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Per-user single docs (advisor settings)
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // User-scoped flat collections — every doc carries user_id
    match /customers/{docId} {
      allow read, update, delete: if isOwner(resource.data.user_id);
      allow create: if isOwner(request.resource.data.user_id);
    }
    match /leads/{docId} {
      allow read, update, delete: if isOwner(resource.data.user_id);
      allow create: if isOwner(request.resource.data.user_id);
    }
    match /referral_partners/{docId} {
      allow read, update, delete: if isOwner(resource.data.user_id);
      allow create: if isOwner(request.resource.data.user_id);
    }
    match /tasks/{docId} {
      allow read, update, delete: if isOwner(resource.data.user_id);
      allow create: if isOwner(request.resource.data.user_id);
    }
    match /documents/{docId} {
      allow read, update, delete: if isOwner(resource.data.user_id);
      allow create: if isOwner(request.resource.data.user_id);
    }
    match /mortgages/{docId} {
      allow read, update, delete: if isOwner(resource.data.user_id);
      allow create: if isOwner(request.resource.data.user_id);
    }
    match /loan_tracks/{docId} {
      allow read, update, delete: if isOwner(resource.data.user_id);
      allow create: if isOwner(request.resource.data.user_id);
    }
    match /bank_responses/{docId} {
      allow read, update, delete: if isOwner(resource.data.user_id);
      allow create: if isOwner(request.resource.data.user_id);
    }
    match /alerts/{docId} {
      allow read, update, delete: if isOwner(resource.data.user_id);
      allow create: if isOwner(request.resource.data.user_id);
    }
    match /commissions/{docId} {
      allow read, update, delete: if isOwner(resource.data.user_id);
      allow create: if isOwner(request.resource.data.user_id);
    }
    match /messages/{docId} {
      allow read, update, delete: if isOwner(resource.data.user_id);
      allow create: if isOwner(request.resource.data.user_id);
    }
    match /signatures/{docId} {
      allow read, update, delete: if isOwner(resource.data.user_id);
      allow create: if isOwner(request.resource.data.user_id);
    }

    // Activity feed and audit log are written only by Cloud Functions (admin SDK).
    match /activity/{docId} {
      allow read: if isOwner(resource.data.user_id);
      allow write: if false;
    }
    match /audit_log/{docId} {
      allow read: if isOwner(resource.data.user_id);
      allow write: if false;
    }

    // Public read collections — written only by Cloud Functions (admin SDK),
    // never by clients, so a single advisor can't pollute global data.
    match /interest_rates/{rateId} {
      allow read: if true;
      allow write: if false;
    }
    match /cpi_index/{cpiId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
