rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /logos/{uid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Uploads are capped and type-restricted here as well as in the client:
    // a client-side check is a courtesy, this is the control.
    match /documents/{customerId}/{file=**} {
      allow read: if request.auth != null &&
        firestore.get(/databases/(default)/documents/customers/$(customerId)).data.user_id == request.auth.uid;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/customers/$(customerId)).data.user_id == request.auth.uid &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf|image/.*');
    }

    match /signatures/{customerId}/{file=**} {
      allow read, write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/customers/$(customerId)).data.user_id == request.auth.uid;
    }

    // Case ZIP exports — readable by the owning advisor, written only by Admin SDK.
    match /exports/{uid}/{file=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
