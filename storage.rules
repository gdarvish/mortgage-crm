rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /logos/{file=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /documents/{customerId}/{file=**} {
      allow read, write: if request.auth != null;
    }

    match /signatures/{customerId}/{file=**} {
      allow read, write: if request.auth != null;
    }
  }
}
